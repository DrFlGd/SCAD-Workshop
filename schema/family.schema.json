{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "family.schema.json",
  "title": "Generator family",
  "description": "One OpenSCAD project (family) as the website described it. The app keeps them for the starter projects that came with apps before 0.4.4 (desktop/core/data/known/).",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "status",
    "models"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "category": {
      "enum": [
        "gridfinity",
        "carrying",
        "labels",
        "wall",
        "other"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "vendor_path": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "spdx",
        "public_use"
      ],
      "properties": {
        "spdx": {
          "type": "string"
        },
        "public_use": {
          "enum": [
            "ok",
            "review",
            "blocked"
          ],
          "description": "ok = can be offered publicly; review = check terms first; blocked = keep hidden"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "engine": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "min_version": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "library_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "available",
        "partial",
        "missing-source",
        "disabled"
      ]
    },
    "additional_entrypoints_available": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "editor_toml": {
      "type": "string",
      "description": "Upstream web-openscad-editor config (editor.toml) whose display conditions, presets, help links and tab settings the site applies"
    },
    "ui": {
      "type": "object",
      "description": "Per-parameter overrides applied to every model in the family (a model's own ui wins). Same form as a model's ui."
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entrypoint": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repo-relative SCAD file. Only allowlisted entrypoints are ever rendered."
        },
        "status": {
          "enum": [
            "available",
            "missing-source",
            "disabled"
          ]
        },
        "engine_override": {
          "type": "object"
        },
        "fixed": {
          "type": "object",
          "description": "Parameters forced to these values and hidden from the form."
        },
        "defaults": {
          "type": "object",
          "description": "Site defaults that replace the SCAD defaults."
        },
        "hidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Parameters not shown in the form."
        },
        "part_parameter": {
          "type": "string",
          "description": "Dropdown parameter that selects which printable part to render; enables 'download all parts'."
        },
        "ui": {
          "type": "object",
          "description": "Per-parameter overrides in editor.toml param-metadata form: display-condition, help-link, description-html, presets, plus label."
        },
        "notes": {
          "type": "string"
        },
        "browser": {
          "type": "boolean",
          "description": "false = can't run in the WebAssembly engine; left off the site"
        },
        "editor_model": {
          "type": "string",
          "description": "[[model]] file name in editor_toml, if not the entrypoint's file name"
        },
        "presets": {
          "type": "array",
          "description": "'Start from' menu: whole-model starting points.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "values"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "values": {
                "type": "object"
              },
              "source_file": {
                "type": "string"
              }
            }
          }
        },
        "extra_params": {
          "type": "array",
          "description": "Settings for variables the file computes with an expression (not exposed by OpenSCAD's Customizer). Passed to OpenSCAD with -D.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "group",
              "default"
            ]
          }
        }
      }
    }
  }
}
